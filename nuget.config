<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    TEMPORARY. The samples use CodeBrix packages that are not on nuget.org yet: the nine
    CodeBrix.WebPlatform packages built from this repository (the five host-tools packages
    included; the samples consume them as packages, like any other application).
    (CodeBrix.WebPlatform.WasmShrink, CodeBrix.RustTools, CodeBrix.LibGit2 and CodeBrix.TomlParse
    are published and come from nuget.org.) Local builds of exactly those nine packages are taken
    from temp-packages (a folder git ignores) beside this file; everything else comes from
    nuget.org. This one file
    serves CodeBrix.WebPlatform.slnx and the solutions of the samples (samples/WorkSite,
    samples/ApplicationSplitter). When the packages are
    published: delete this file and the folder, and set the published versions in the project
    files. See TEMPORARY PACKAGES in MAINTAINER-README.txt beside this file.
  -->
  <packageSources>
    <add key="webplatform-temp-packages" value="temp-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="webplatform-temp-packages">
      <package pattern="CodeBrix.WebPlatform.Core.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.Backend.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.BackendMapper.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.LinuxX64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.LinuxArm64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.WindowsX64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.MacOSArm64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.MacOSX64.ApacheLicenseForever" />
    </packageSource>
  </packageSourceMapping>
</configuration>
