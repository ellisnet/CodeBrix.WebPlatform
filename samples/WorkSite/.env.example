# Settings for the two WorkSite containers. Copy to `.env` (git ignores it) and fill in, or let
# `WorkSite.BuildFrontend env` (samples/WorkSite/build) create `.env` with random secrets.
# Never commit real values.

# Password of the PostgreSQL user the application connects as.
WORKSITE_DB_PASSWORD=

# Key that signs the sign-in tokens. At least 32 random characters.
WORKSITE_JWT_SIGNING_KEY=

# The HTTPS development certificate (`dotnet dev-certs https`), exported as a .pfx file by
# `WorkSite.BuildFrontend cert`: the file's full path on this machine, and the password protecting it.
WORKSITE_CERT_FILE=
WORKSITE_CERT_PASSWORD=

# The port the site listens on: https://localhost:<port>
WORKSITE_HTTPS_PORT=8443

# Demo account with sample clients, projects and hours, created when the database is first set up.
WORKSITE_DEMO_ENABLED=true
WORKSITE_DEMO_USERNAME=demo
WORKSITE_DEMO_PASSWORD=
