<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      The built frontend is in frontend-built/ beside this file (build output: FrontendBuilder
      writes it there, and the folder ignores itself in git). The Backend package serves it as
      plain files and carries the folder into the build and publish output. The SDK's
      static-web-assets layer is switched off so that a development or test host serves exactly
      those files and nothing else from this project folder.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RootNamespace>WorkSite.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\WorkSite.Core\WorkSite.Core.csproj" />
    <ProjectReference Include="..\libs\WorkSite.DataAccess\WorkSite.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The published package. The same version as CodeBrix.WebPlatform.Core in
      ..\libs\WorkSite.Core\WorkSite.Core.csproj and WebPlatformPackageVersion in
      ..\..\build\WorkSite.BuildFrontend\WorkSite.BuildFrontend.csproj.
    -->
    <PackageReference Include="CodeBrix.WebPlatform.Backend.ApacheLicenseForever" Version="1.0.327.240" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
  </ItemGroup>

</Project>
