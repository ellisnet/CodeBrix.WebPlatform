<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WorkSite.DataAccess</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="WorkSite.DataAccess.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkSite.Core\WorkSite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.PostgresClient.PostgreSqlLicenseForever" Version="1.0.281.152" />
  </ItemGroup>

</Project>
