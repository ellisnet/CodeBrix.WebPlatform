<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      The built frontend applications are in frontend-built/ beside this file (build output: the
      build program writes them there, and the folder ignores itself in git). The Backend package
      serves them as plain files and carries the folder into the build and publish output. The
      SDK's static-web-assets layer is switched off so that a development or test host serves
      exactly those files and nothing else from this project folder.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RootNamespace>ApplicationSplitter.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The published CodeBrix.WebPlatform packages, from nuget.org: ONE version for all of them, as
      they are published together (THE SAMPLES' PACKAGES in the root MAINTAINER-README.txt).
    -->
    <WebPlatformPackageVersion>1.0.329.452</WebPlatformPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform's backend library; it brings CodeBrix.WebPlatform.Core with it. -->
    <PackageReference Include="CodeBrix.WebPlatform.Backend.ApacheLicenseForever" Version="$(WebPlatformPackageVersion)" />
  </ItemGroup>

</Project>
