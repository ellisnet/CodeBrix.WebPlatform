<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.WebPlatform.Backend\CodeBrix.WebPlatform.Backend.csproj" />
    <!-- The small backend the tests host in memory. It is built with this project and found beside it. -->
    <ProjectReference Include="..\CodeBrix.WebPlatform.Backend.Tests.SampleBackend\CodeBrix.WebPlatform.Backend.Tests.SampleBackend.csproj" />
  </ItemGroup>

  <!--
    The frontend build's manifest writer, compiled in from its source so that the round-trip tests
    read exactly what the frontend build writes. It needs only Core. (A project reference to
    FrontendBuilder would build that library, its crates archive and its native packages for a
    test that uses one small class.)
  -->
  <ItemGroup>
    <Compile Include="..\..\src\CodeBrix.WebPlatform.FrontendBuilder\Applications\FrontendManifestWriter.cs" Link="Linked\FrontendManifestWriter.cs" />
  </ItemGroup>

  <!--
    The package's buildTransitive targets file, copied beside the test assembly so that a test can
    check that it names the built frontend's folder the backend serves from. (That it carries the
    folder into a publish is checked by hand; MAINTAINER-README says how.)
  -->
  <ItemGroup>
    <None Include="..\..\src\CodeBrix.WebPlatform.Backend\buildTransitive\CodeBrix.WebPlatform.Backend.ApacheLicenseForever.targets"
          Link="Packaging\CodeBrix.WebPlatform.Backend.ApacheLicenseForever.targets"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.320.258" />
  </ItemGroup>

</Project>
