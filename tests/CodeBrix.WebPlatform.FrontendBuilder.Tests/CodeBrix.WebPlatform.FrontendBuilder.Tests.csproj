<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.WebPlatform.FrontendBuilder\CodeBrix.WebPlatform.FrontendBuilder.csproj" />
    <!-- A small backend to materialize a frontend from. It is built with this project and found beside it. -->
    <ProjectReference Include="..\CodeBrix.WebPlatform.BackendMapper.Tests.SampleBackend\CodeBrix.WebPlatform.BackendMapper.Tests.SampleBackend.csproj" />
  </ItemGroup>

  <!--
    The packaged Tailwind program of the machine the tests are built on, copied into this
    project's output as tailwind/<rid>/ - as a host-tools package brings it to a build program -
    so that the tests that run Tailwind run the real one. (The host-tools packages themselves are
    not referenced: most tests here check what happens when dx and wasm-bindgen are missing.)
  -->
  <ItemGroup>
    <PackageReference Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'" Include="CodeBrix.WebPlatform.Styling.Tailwind4.LinuxX64.MitLicenseForever" Version="1.0.327.82" />
    <PackageReference Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'" Include="CodeBrix.WebPlatform.Styling.Tailwind4.LinuxArm64.MitLicenseForever" Version="1.0.327.82" />
    <PackageReference Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'" Include="CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64.MitLicenseForever" Version="1.0.327.82" />
    <PackageReference Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'" Include="CodeBrix.WebPlatform.Styling.Tailwind4.MacOSArm64.MitLicenseForever" Version="1.0.327.82" />
    <PackageReference Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'" Include="CodeBrix.WebPlatform.Styling.Tailwind4.WindowsX64.MitLicenseForever" Version="1.0.327.82" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.320.258" />
  </ItemGroup>

</Project>
