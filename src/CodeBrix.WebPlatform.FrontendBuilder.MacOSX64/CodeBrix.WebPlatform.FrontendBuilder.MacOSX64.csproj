<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebPlatform.FrontendBuilder.MacOSX64</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.FrontendBuilder.MacOSX64</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebPlatform.FrontendBuilder.MacOSX64.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.WebPlatform.FrontendBuilder.MacOSX64</Product>
    <Title>CodeBrix.WebPlatform.FrontendBuilder.MacOSX64</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>The prebuilt build tools of the CodeBrix.WebPlatform web application platform for macOS on Intel (x64) build machines: the Dioxus CLI (dx, built from a patched dioxus-cli) and the wasm-bindgen CLI, with their licence and third-party notices files. Referencing the package copies them into the build program's output folder as frontend-tools/osx-x64/, where CodeBrix.WebPlatform.FrontendBuilder finds them - nothing has to be compiled or installed. Choose the package of the machine the frontend is BUILT on.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebPlatform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebPlatform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>webassembly;wasm;dioxus;dx;wasm-bindgen;rust;build;tools;macos;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The osx-x64 programs, committed under native_libraries/osx-x64/ and built by the scripts in
    tools/dx-native-tools (see tools/dx-native-tools/README.txt): dx and wasm-bindgen,
    their LICENSE-*.txt files and their THIRD-PARTY-NOTICES-*.txt files. The *.provenance.txt build
    records beside them stay in the repository and are not shipped. This package holds ONLY the
    osx-x64 files; every build platform has a package of its own.

    They are NOT packed under runtimes/<rid>/native (that convention is for libraries a process
    loads, and NuGet mixes and flattens that folder). A program needs a folder of its own at a
    fixed place, so - as in CodeBrix.WebPlatform.WasmShrink:
      * in the package they sit under tools/frontend-tools/osx-x64/, and
        buildTransitive/CodeBrix.WebPlatform.FrontendBuilder.MacOSX64.ApacheLicenseForever.targets copies that tree into the consuming project's output folder
        as frontend-tools/osx-x64/;
      * for a project reference (the tests), the items below do the same copy directly.

    THE FOLDER NAME frontend-tools/<rid>/ IS A CONTRACT: CodeBrix.WebPlatform.FrontendBuilder looks
    for <application base folder>/frontend-tools/<rid>/dx[.exe] and wasm-bindgen[.exe].

    The osx-x64 programs were first built and adopted on 2026-11-22 (tools/dx-native-tools/
    BUILD-PROVENANCE.txt). Should native_libraries/osx-x64/ ever be missing, the package still packs,
    with the assembly and no programs - and must not be published.
  -->
  <ItemGroup>
    <None Include="..\..\native_libraries\osx-x64\**\*" Exclude="..\..\native_libraries\osx-x64\**\*.provenance.txt"
          Pack="true" PackagePath="tools\frontend-tools\osx-x64"
          Link="frontend-tools\osx-x64\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="buildTransitive\CodeBrix.WebPlatform.FrontendBuilder.MacOSX64.ApacheLicenseForever.targets"
          Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
