<Project>

  <!--
    Copies the linux-x64 build tools that ship in this package (tools/frontend-tools/linux-x64/: dx,
    wasm-bindgen and their licence and notices files) into the output folder of the project
    that references it - directly or through another package - as frontend-tools/linux-x64/.
    CodeBrix.WebPlatform.FrontendBuilder looks for them there.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\tools\frontend-tools\**\*"
          Link="frontend-tools\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
