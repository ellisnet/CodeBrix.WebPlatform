<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebPlatform.FrontendBuilder</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.FrontendBuilder</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.WebPlatform.FrontendBuilder</Product>
    <Title>CodeBrix.WebPlatform.FrontendBuilder</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>The build-time library a build program calls to build the Rust WebAssembly frontend of a CodeBrix.WebPlatform application: it checks the prerequisites and says what is missing, writes the client code generated from the compiled backend, the platform's shared Rust crate, the platform's Rust crates (carried as one archive, with their notices) and the cargo configuration into the frontend, so that plain cargo works there offline, and runs the Dioxus build tool to build or serve the site, shrinking release builds with the packaged wasm-opt. No Node.js. It is used while an application is built and is not part of the built application.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebPlatform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebPlatform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>web;rust;webassembly;wasm;dioxus;frontend;build;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.WebPlatform.BackendMapper\CodeBrix.WebPlatform.BackendMapper.csproj" />
    <ProjectReference Include="..\CodeBrix.WebPlatform.Core\CodeBrix.WebPlatform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.LibGit2.MitLicenseForever" Version="1.0.323.362" />
    <PackageReference Include="CodeBrix.RustTools.MitLicenseForever" Version="1.0.323.391" />
    <PackageReference Include="CodeBrix.WebPlatform.WasmShrink.ApacheLicenseForever" Version="1.0.323.365" />
  </ItemGroup>

  <!--
    The shared Rust crate (Rust/codebrix-webplatform) travels inside the assembly as embedded
    resources named "CodeBrix.WebPlatform.FrontendBuilder.Rust/<path inside the crate>".
    SharedRustCrate writes it out when a frontend is materialized. Cargo's own output (target,
    Cargo.lock) and the .cargo folder, which only serves `cargo test` in this repository, are left
    out.
  -->
  <PropertyGroup>
    <!-- The vendored crates are data for the archive below, never project items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Rust\vendor\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Rust\**" />
    <EmbeddedResource Include="Rust\codebrix-webplatform\**\*"
                      Exclude="Rust\codebrix-webplatform\target\**;Rust\codebrix-webplatform\Cargo.lock;Rust\codebrix-webplatform\.cargo\**"
                      LogicalName="CodeBrix.WebPlatform.FrontendBuilder.Rust/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The platform's lock file: written into a frontend that has no Cargo.lock yet. -->
    <EmbeddedResource Include="Rust\platform-crates\Cargo.lock"
                      LogicalName="CodeBrix.WebPlatform.FrontendBuilder.PlatformCrates/Cargo.lock" />
  </ItemGroup>

  <!--
    THE PLATFORM'S CRATES. Rust/vendor holds every crate a platform frontend may use (written by
    `cargo vendor` from Rust/platform-crates; about 15,000 files). They travel as ONE archive, not
    inside the assembly and not as loose files:
      * _CreatePlatformCratesArchive zips Rust/vendor into obj/frontend-crates/, only when a
        file in it (or the platform's lock file) is newer than the archive;
      * the archive and the generated notices for those crates
        (Rust/notices/THIRD-PARTY-NOTICES-PlatformCrates.txt) are packed under
        tools/frontend-crates/, and buildTransitive/CodeBrix.WebPlatform.FrontendBuilder
        .ApacheLicenseForever.targets copies them into the consuming project's output folder as
        frontend-crates/ - the same pattern as the WasmShrink and host-tools packages;
      * for a project reference (the tests), the None items below do the same copy directly.
    THE FOLDER NAME frontend-crates/ IS A CONTRACT: PlatformCrates (Crates/PlatformCrates.cs)
    looks for <application base folder>/frontend-crates/platform-crates.zip.
  -->
  <PropertyGroup>
    <_PlatformCratesArchive>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)frontend-crates\platform-crates.zip</_PlatformCratesArchive>
  </PropertyGroup>

  <ItemGroup>
    <_PlatformCrateFile Include="Rust\vendor\**\*" />
    <_PlatformCrateFile Include="Rust\platform-crates\Cargo.lock" />
    <None Include="$(_PlatformCratesArchive)"
          Pack="true" PackagePath="tools\frontend-crates"
          Link="frontend-crates\platform-crates.zip"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="Rust\notices\THIRD-PARTY-NOTICES-PlatformCrates.txt"
          Pack="true" PackagePath="tools\frontend-crates"
          Link="frontend-crates\THIRD-PARTY-NOTICES-PlatformCrates.txt"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="buildTransitive\CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever.targets"
          Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <Target Name="_CreatePlatformCratesArchive"
          BeforeTargets="AssignTargetPaths;BeforeBuild"
          Inputs="@(_PlatformCrateFile)"
          Outputs="$(_PlatformCratesArchive)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_PlatformCratesArchive)'))" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\Rust\vendor"
                  DestinationFile="$(_PlatformCratesArchive)"
                  Overwrite="true" />
  </Target>

</Project>
